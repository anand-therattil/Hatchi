# Copy to .env and adjust. Every value shown is the default.

# --- Backends -------------------------------------------------------------
# services = Redis + MongoDB (docker compose)   | memory = in-process, no infra
STORAGE_BACKEND=services
# http = Chroma server (docker compose) | persistent = local folder | ephemeral = RAM
VECTOR_BACKEND=http
# vllm = vLLM OpenAI-compatible server | ollama = Ollama | mock = canned replies (tests / demo)
LLM_BACKEND=vllm
# granite = sentence-transformers model | fake = hashed bag-of-words (tests)
EMBEDDING_BACKEND=granite

# --- Infrastructure -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
MONGO_URL=mongodb://localhost:27017
MONGO_DB=hatchi
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PATH=./.chroma

# --- Models ---------------------------------------------------------------
# vLLM via docker compose (docker compose --profile gpu up -d) reads these same values:
HF_TOKEN=
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_BASE_URL=http://localhost:8002
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
VLLM_API_KEY=
# Ollama (LLM_BACKEND=ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_MAX_TOKENS=512
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
# Check the model card for any query/document prefix convention.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOC_PREFIX=

# --- Conversation window / summaries ---------------------------------------
HISTORY_MAX_MESSAGES=12
HISTORY_FOLD_COUNT=6
SESSION_IDLE_SECONDS=1800
SESSION_TTL_SECONDS=86400
WS_DISCONNECT_GRACE_SECONDS=60

# --- Retrieval --------------------------------------------------------------
# Real embedding scores are compressed (Granite-97M: relevant ~0.90, unrelated ~0.79), so these are high.
# Measured on Granite-97M; re-run `python -m scripts.calibrate_similarity` if you change the embedding model.
MEMORY_TOP_K=5
MEMORY_MIN_SIMILARITY=0.845
SEMANTIC_MARGIN=0.10
SUMMARY_TOP_K=2
SUMMARY_MIN_SIMILARITY=0.83
SUMMARY_RECALL_MIN_SIMILARITY=0.83
FACT_DEDUPE_SIMILARITY=0.9
